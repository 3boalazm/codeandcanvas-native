+/* ---------- Reader shell ---------- */
+.reader { --rd-h: calc(100svh - var(--nav-h)); position: relative; display: grid; grid-template-columns: 240px minmax(0, 1fr) 300px; gap: 14px; min-height: var(--rd-h); padding: 14px 0 24px; }
