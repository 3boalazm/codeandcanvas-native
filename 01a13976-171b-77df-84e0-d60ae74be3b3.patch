+.person__links a { display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 999px; border: 1px solid var(--line); background: rgba(255,255,255,.04); font-size: 13.5px; color: var(--ink-2); transition: border-color .3s, color .3s, transform .3s var(--ease); }
+.person__links a:hover { color: #fff; border-color: var(--line-2); transform: translateY(-2px); }
+.person__links .ico { font-size: 15px; color: var(--teal); }
+.creds { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
+.creds span { padding: 5px 11px; border-radius: 10px; border: 1px solid rgba(139,108,255,.35); background: rgba(139,108,255,.1); color: #d6ccff; font-size: 12.5px; font-weight: 600; }
+.person--big { grid-template-columns: 300px minmax(0, 1fr); padding: clamp(24px, 3vw, 40px); }
+.person--big .art { aspect-ratio: 4 / 5; border-radius: 24px; }
+
+/* ---------- Quote / statement blocks ---------- */
+.quote { position: relative; padding: clamp(26px, 3vw, 40px); border-radius: var(--r-lg); font-family: var(--f-title); font-size: clamp(19px, 1.9vw, 26px); font-weight: 500; line-height: 1.5; color: #fff; }
