+/* ==========================================================================
+   Code & Canvas — inner-page components (every page except / and /erp/)
+   Builds on ds.css. Logical properties throughout so one rule set serves
+   English (LTR) and Arabic (RTL). Nothing here depends on a build step.
+   ========================================================================== */
+
+[hidden] { display: none !important; }
+
+/* ---------- Page hero ---------- */
+.phero { position: relative; padding-top: calc(var(--nav-h) + clamp(56px, 9vw, 120px)); padding-bottom: clamp(40px, 6vw, 80px); }
+.phero--center { text-align: center; }
+.phero--center .eyebrow, .phero--center .crumbs { margin-inline: auto; }
+.phero--center .hero__lead, .phero--center .hero__ctas, .phero--center .hero__chips { margin-inline: auto; justify-content: center; }
+.phero__title { font-size: clamp(36px, 5vw, 70px); font-weight: 800; margin: 22px 0 20px; line-height: 1.22; text-wrap: balance; }
+html[lang='en'] .phero__title { line-height: 1.04; }
+.phero__title .grad-text { padding-inline-end: .06em; }
+.phero .hero__lead { max-width: 720px; font-size: clamp(16.5px, 1.4vw, 19.5px); }
+.phero__split { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(28px, 5vw, 70px); align-items: center; }
+.phero__aside { display: grid; gap: 14px; }
+.phero__meta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 26px; color: var(--ink-3); font-size: 14px; }
+.phero__meta span { display: inline-flex; align-items: center; gap: 8px; }
+.phero__meta .ico { color: var(--teal); font-size: 15px; }
+.crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 18px; color: var(--ink-3); font-size: 13.5px; font-family: var(--f-title); }
+.crumbs a { color: var(--ink-2); transition: color .25s; }
+.crumbs a:hover { color: #fff; }
+.crumbs i { opacity: .5; font-style: normal; }
+.crumbs span[aria-current] { color: var(--teal); }
+
+/* ---------- Section rhythm ---------- */
+.section--tight { padding-block: clamp(48px, 7vw, 96px); }
+.section--flush-top { padding-top: 0; }
+.divider { height: 1px; background: linear-gradient(90deg, transparent, var(--line-2), transparent); }
+
+/* ---------- Grids ---------- */
+.grid { display: grid; gap: 18px; }
+.grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.grid--side { grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(24px, 4vw, 56px); align-items: start; }
+.grid--side-l { grid-template-columns: 340px minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
+.sticky { position: sticky; top: calc(var(--nav-h) + 24px); }
+
+/* ---------- Icon cards / feature tiles ---------- */
+.tile { display: flex; flex-direction: column; padding: 26px; min-height: 0; }
+.tile .card__icon { width: 46px; height: 46px; font-size: 21px; border-radius: 14px; margin-bottom: 18px; }
+.tile h3 { font-size: clamp(18px, 1.5vw, 21px); margin-bottom: 8px; }
+.tile p { font-size: 14.8px; line-height: 1.7; }
+.tile__num { color: var(--ink-3); font-family: var(--f-num); font-style: italic; font-size: 14px; margin-bottom: 14px; direction: ltr; }
+.tile__foot { margin-top: auto; padding-top: 16px; color: var(--ink-3); font-size: 13.5px; }
+.tile--accent { border-color: rgba(139,108,255,.4); background: linear-gradient(160deg, rgba(122,85,224,.22), rgba(63,214,196,.05) 70%), var(--glass); }
+
+/* ---------- Tick lists ---------- */
+.ticks { display: grid; gap: 10px; }
+.ticks li { display: flex; align-items: flex-start; gap: 12px; font-size: 15.5px; color: var(--ink-2); line-height: 1.6; }
+.ticks li::before { content: '✓'; flex: none; width: 24px; height: 24px; margin-top: 2px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 800; color: var(--teal); background: rgba(63,214,196,.12); border: 1px solid rgba(63,214,196,.25); }
+.ticks--x li::before { content: '×'; color: var(--pink); background: rgba(238,91,163,.12); border-color: rgba(238,91,163,.3); font-size: 15px; }
+.ticks--dense { gap: 7px; }
+.ticks--dense li { font-size: 14.5px; }
+.ticks--cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; }
+
+/* ---------- Service detail blocks ---------- */
+.sdetail { --acc: var(--teal); position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(22px, 3vw, 44px); padding: clamp(24px, 3vw, 40px); border-radius: var(--r-lg); scroll-margin-top: calc(var(--nav-h) + 24px); }
+.sdetail--creative { --acc: #b8a9ff; }
+.sdetail--health { --acc: var(--pink); }
+.sdetail--combined { --acc: var(--gold); }
+.sdetail + .sdetail { margin-top: 18px; }
+.sdetail__head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; }
+.sdetail__code { font-family: var(--f-num); font-style: italic; font-size: 14px; color: var(--ink-3); direction: ltr; }
+.sdetail__tag { padding: 4px 11px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--acc) 38%, transparent); background: color-mix(in srgb, var(--acc) 9%, transparent); color: var(--acc); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
+html[lang='ar'] .sdetail__tag { letter-spacing: 0; text-transform: none; font-size: 12px; }
+.sdetail__star { color: var(--gold); font-size: 13px; }
+.sdetail h3 { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.2; margin-bottom: 12px; }
+.sdetail__lead { color: var(--ink-2); font-size: 15.5px; margin-bottom: 20px; }
+.sdetail h4 { font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--acc); margin: 20px 0 10px; }
+html[lang='ar'] .sdetail h4 { letter-spacing: 0; text-transform: none; font-size: 14px; }
+.sdetail__side { display: grid; gap: 14px; align-content: start; }
+.sdetail__price { padding: 20px 22px; border-radius: 18px; border: 1px solid color-mix(in srgb, var(--acc) 28%, transparent); background: color-mix(in srgb, var(--acc) 7%, transparent); }
+.sdetail__price strong { display: block; color: var(--acc); font-family: 'Raleway', 'Alexandria', sans-serif; font-size: clamp(22px, 2vw, 28px); font-weight: 800; line-height: 1.15; direction: ltr; }
+html[lang='ar'] .sdetail__price strong { text-align: right; }
+.sdetail__price span { display: block; margin-top: 6px; color: var(--ink-2); font-size: 14px; }
+.sdetail__price small { display: block; margin-top: 8px; color: var(--ink-3); font-size: 12.5px; }
+.sdetail__kv { display: grid; gap: 8px; padding: 18px 20px; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,.03); font-size: 14px; }
+.sdetail__kv div { display: flex; justify-content: space-between; gap: 14px; }
+.sdetail__kv dt { color: var(--ink-3); }
+.sdetail__kv dd { margin: 0; color: #fff; font-weight: 600; text-align: end; }
+.sdetail__side .btn { justify-content: center; }
+.sdetail__lead-by { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-3); font-size: 13.5px; }
+.sdetail__lead-by b { color: var(--ink-2); font-weight: 600; }
+.tiers { display: grid; gap: 10px; }
+.tier { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 18px; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: rgba(255,255,255,.035); }
+.tier b { font-size: 15px; font-weight: 700; }
+.tier p { grid-column: 1; font-size: 13.5px; color: var(--ink-3); }
+.tier strong { grid-row: 1 / span 2; align-self: center; color: var(--acc); font-family: 'Raleway', 'Alexandria', sans-serif; font-weight: 800; font-size: 16px; direction: ltr; white-space: nowrap; }
+.tier small { grid-column: 2; grid-row: 2; align-self: end; color: var(--ink-3); font-size: 12.5px; text-align: end; }
+.tier--star { border-color: rgba(243,199,122,.35); background: rgba(243,199,122,.06); }
+
+/* ---------- Track header strip ---------- */
+.track-head { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-bottom: 26px; }
+.track-head h2 { font-size: clamp(26px, 3vw, 40px); }
+.track-head .pill { margin-inline-start: auto; }
+
+/* ---------- Table / matrix ---------- */
+.matrix { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; font-size: 14.5px; }
+.matrix th, .matrix td { padding: 14px 18px; text-align: start; vertical-align: top; border-bottom: 1px solid var(--line); }
+.matrix th { background: rgba(255,255,255,.06); font-family: var(--f-title); font-size: 12.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
+html[lang='ar'] .matrix th { letter-spacing: 0; text-transform: none; font-size: 13.5px; }
+.matrix tr:last-child td { border-bottom: 0; }
+.matrix tbody tr:hover td { background: rgba(255,255,255,.03); }
+.matrix td strong { color: var(--teal); font-family: 'Raleway', 'Alexandria', sans-serif; font-weight: 800; direction: ltr; display: inline-block; }
+.matrix .code { font-family: var(--f-num); font-style: italic; color: var(--ink-3); direction: ltr; white-space: nowrap; }
+.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--r); }
+
+/* ---------- Art tiles (placeholder imagery in DS colours; swap via data-slot) ---------- */
+.art { position: relative; overflow: hidden; border-radius: var(--r); aspect-ratio: 4 / 3; background: linear-gradient(145deg, #1a1446, #0a0a26 60%, #0d1f33); border: 1px solid var(--line); isolation: isolate; display: grid; place-items: center; }
+.art--wide { aspect-ratio: 16 / 9; }
+.art--square { aspect-ratio: 1; }
+.art--tall { aspect-ratio: 3 / 4; }
+.art--portrait { aspect-ratio: 4 / 5; }
+.art::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 60% at 20% 15%, rgba(139,108,255,.45), transparent 60%), radial-gradient(50% 50% at 85% 85%, rgba(63,214,196,.3), transparent 60%), radial-gradient(40% 40% at 70% 20%, rgba(238,91,163,.22), transparent 60%); }
+.art::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 85%); -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 30%, transparent 85%); }
+.art > * { position: relative; z-index: 1; }
+.art__mark { font-family: var(--f-num); font-style: italic; font-weight: 800; font-size: clamp(42px, 7vw, 96px); line-height: 1; letter-spacing: -.02em; background: linear-gradient(180deg, #fff 20%, rgba(255,255,255,.35)); -webkit-background-clip: text; background-clip: text; color: transparent; direction: ltr; }
+.art__cap { position: absolute; z-index: 1; inset-inline-start: 18px; bottom: 16px; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--line-2); background: rgba(5,5,26,.55); backdrop-filter: blur(8px); font-size: 11.5px; font-weight: 700; letter-spacing: .1em; color: var(--ink-2); }
+html[lang='ar'] .art__cap { letter-spacing: 0; font-size: 12.5px; }
+.art .ico { font-size: 56px; color: rgba(255,255,255,.75); }
+.art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
+.art--teal { background: linear-gradient(145deg, #0b2a2c, #0a0a26 60%, #1a1446); }
+.art--pink { background: linear-gradient(145deg, #3a1230, #0a0a26 60%, #1a1446); }
+.art--gold { background: linear-gradient(145deg, #3a2a10, #0a0a26 60%, #1a1446); }
+
+/* ---------- People ---------- */
+.person { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; padding: 26px; align-items: start; }
+.person .art { aspect-ratio: 1; border-radius: 22px; }
+.person__role { color: var(--teal); font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 8px; }
+html[lang='ar'] .person__role { letter-spacing: 0; text-transform: none; font-size: 14px; }
+.person h3 { font-size: clamp(22px, 2vw, 28px); margin-bottom: 6px; }
+.person__tag { color: var(--ink-3); font-size: 14px; margin-bottom: 14px; }
