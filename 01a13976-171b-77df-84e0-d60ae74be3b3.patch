+.slide { width: min(100%, 980px); aspect-ratio: 16 / 9; display: grid; align-content: center; gap: 14px; padding: clamp(24px, 4vw, 56px); border-radius: 18px; border: 1px solid var(--line-2); background: linear-gradient(150deg, rgba(255,255,255,.08), rgba(255,255,255,.02)); box-shadow: var(--shadow); }
