+}
+
+/* ---------- 08 · Static capability loop + concentric rings (REF 013 / 027) ---------- */
+.sys-loop { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr); gap: 22px; align-items: center; margin-top: 22px; }
+.sys-loop__ring { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(74px, auto)); gap: 10px; margin: 0; padding: 0; list-style: none; }
+.sys-loop__pill { display: grid; place-items: center; min-width: 0; padding: 8px 6px; border: 1px solid var(--line-2); border-radius: 999px; background: var(--panel); color: var(--ink-2); font-family: var(--f-title); font-size: 11.5px; font-weight: 700; text-align: center; }
+.sys-loop__pill--1 { grid-area: 1 / 1; }
+.sys-loop__pill--2 { grid-area: 1 / 2; }
+.sys-loop__pill--3 { grid-area: 1 / 3; }
+.sys-loop__pill--4 { grid-area: 2 / 1; }
+.sys-loop__pill--5 { grid-area: 2 / 3; }
+.sys-loop__pill--6 { grid-area: 3 / 1; }
+.sys-loop__pill--7 { grid-area: 3 / 2; }
+.sys-loop__pill--8 { grid-area: 3 / 3; }
+.sys-loop__core { grid-area: 2 / 2; display: grid; place-content: center; gap: 6px; min-width: 0; padding: 14px 10px; border: 1px solid rgba(139,108,255,.42); border-radius: var(--r); background: linear-gradient(150deg, rgba(139,108,255,.14), var(--panel)); text-align: center; }
+.sys-loop__core span { color: var(--ink-teal, var(--teal)); font-family: var(--f-num); font-size: 9.5px; font-weight: 800; letter-spacing: .14em; }
+.sys-loop__core strong { font-family: var(--f-title); font-size: 13px; line-height: 1.35; }
+html[lang='ar'] .sys-loop__core span { letter-spacing: 0; }
+.sys-concentric { position: relative; inline-size: min(100%, 340px); aspect-ratio: 1; margin-inline: auto; }
+.sys-concentric__ring { position: absolute; display: flex; flex-direction: column; align-items: center; gap: 4px; padding-top: 14px; border: 1px solid var(--line-2); border-radius: 50%; text-align: center; }
+.sys-concentric__ring--why { inset: 0; }
+.sys-concentric__ring--how { inset: 18%; }
+.sys-concentric__ring--what { inset: 36%; background: var(--panel); }
+.sys-concentric__label { color: var(--ink-teal, var(--teal)); font-family: var(--f-num); font-size: 10px; font-weight: 800; letter-spacing: .14em; }
+html[lang='ar'] .sys-concentric__label { letter-spacing: 0; }
+.sys-concentric__note { max-inline-size: 78%; color: var(--ink-2); font-size: 10px; line-height: 1.4; }
+
+/* ---------- 09 · Static process map, steps, step bar and art card (REF 017/037/052/055/030) ---------- */
+.sys-process { display: grid; gap: 18px; margin-top: 22px; }
