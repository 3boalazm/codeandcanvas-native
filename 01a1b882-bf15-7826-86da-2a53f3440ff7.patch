+.sys-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
+.sys-step { min-width: 0; padding: 16px; border: 1px solid var(--line-2); border-radius: var(--r); background: var(--panel); }
+.sys-step__no { display: block; color: var(--ink-teal, var(--teal)); font-family: var(--f-num); font-size: 10.5px; font-weight: 800; letter-spacing: .14em; }
+.sys-step h3 { margin: 8px 0 10px; font-family: var(--f-title); font-size: 15px; }
+.sys-step ul { margin: 0; padding-inline-start: 16px; color: var(--ink-2); font-size: 11.5px; line-height: 1.6; }
+.sys-step li + li { margin-top: 4px; }
+.sys-stepbar { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
+.sys-stepbar__node { display: flex; align-items: center; gap: 8px; padding: 7px 12px; border: 1px solid var(--line-2); border-radius: 999px; background: var(--glass); color: var(--ink-2); font-size: 11.5px; }
+.sys-stepbar__node b { color: var(--ink-teal, var(--teal)); font-family: var(--f-num); font-size: 10px; letter-spacing: .1em; }
+.sys-artcard { position: relative; margin: 4px 0 0; overflow: hidden; border: 1px solid var(--line-2); border-radius: var(--r-lg); background: #080824; }
+.sys-artcard img { display: block; inline-size: 100%; block-size: auto; }
+.sys-artcard__caption { position: absolute; inset-inline: 0; inset-block-end: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 18px 20px; background-color: #080824; background-image: linear-gradient(0deg, rgba(7,7,28,.96), rgba(7,7,28,.62) 72%, rgba(7,7,28,.12)); }
+.sys-artcard__caption .sys-status { color: var(--teal); }
+.sys-artcard__caption strong { flex: 1 1 240px; color: #fff; font-family: var(--f-title); font-size: 13.5px; }
+.sys-artcard__ctas { display: flex; flex-wrap: wrap; gap: 8px; }
+.sys-artcard__caption .btn--primary, .sys-artcard__caption .btn--ghost { color: #fff; }
+.sys-artcard__caption .btn--ghost { border: 1px solid rgba(255,255,255,.42); background: rgba(255,255,255,.06); }
+.sys-artcard__caption .btn--ghost:hover { background: rgba(255,255,255,.12); }
+@media (max-width: 980px) {
+  .sys-loop { grid-template-columns: minmax(0, 1fr); }
+  .sys-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 720px) {
+  .sys-loop__ring { grid-template-rows: repeat(3, minmax(58px, auto)); gap: 7px; }
+  .sys-loop__pill { font-size: 10px; padding: 6px 4px; }
+  .sys-loop__core strong { font-size: 11.5px; }
+  .sys-concentric { inline-size: min(100%, 280px); }
+  .sys-concentric__note { font-size: 9px; }
+  .sys-process__curve { block-size: 56px; }
+  .sys-steps { grid-template-columns: minmax(0, 1fr); }
+  .sys-artcard__caption { position: static; background-color: #080824; }
+}
